# Application
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (server-only)
MONGODB_URI=mongodb://localhost:27017/signalist

# Better Auth (server-only)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Finnhub market data (server-only; never use a NEXT_PUBLIC_ prefix)
FINNHUB_API_KEY=your-finnhub-api-key

# Inngest (server-only; hosted credentials are optional for local development with the Inngest Dev Server)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Gemini for Inngest AI steps (server-only)
GEMINI_API_KEY=your-gemini-api-key

# Gmail SMTP / Nodemailer (server-only)
NODEMAILER_EMAIL=your-gmail-address
NODEMAILER_PASSWORD=your-gmail-app-password

# Optional live-test settings; a test email is sent only when SMTP_TEST_RECIPIENT is explicitly set
SMTP_TEST_RECIPIENT=
FINNHUB_TEST_SYMBOL=AAPL
